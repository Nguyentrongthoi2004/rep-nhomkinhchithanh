{
  "name": "mini-erp-be",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for MiniERP Nhôm Kính Chí Thành (Express + TypeScript + Supabase)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^20.14.10",
    "eslint": "^9.25.1",
    "globals": "^15.15.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.30.1",
    "typescript": "^5.6.3"
  }
}
